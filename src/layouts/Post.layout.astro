---
import { LayoutProvider, StylesProvider } from '@/providers';

const { modifiedTime, publishedTime, section, tags, type, ...layoutProps } =
  Astro.props;
---

<LayoutProvider {...layoutProps}>
  <Fragment slot='meta'>
    <meta property='article:author' content="Diego '@dgbragas' Braga" />
    <meta property='article:section' content={section} />
    <meta property='article:tag' content={tags} />
    <meta property='article:published_time' content={publishedTime} />
    <meta property='article:modified_time' content={modifiedTime} />
  </Fragment>

  <StylesProvider>
    <article>
      <h1>{layoutProps.title}</h1>
      <p>Content</p>
    </article>
  </StylesProvider>
</LayoutProvider>
