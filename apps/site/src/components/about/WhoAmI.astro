---
import { Image } from 'astro:assets';

import { Container, Tag, Text } from '@dgbragas/yalatus';

import arco from '@/assets/about/companies/arco.svg';
import caju from '@/assets/about/companies/caju.svg';
import cosmobots from '@/assets/about/companies/cosmobots.svg';
import digisystem from '@/assets/about/companies/digisystem.svg';
import semantix from '@/assets/about/companies/semantix.svg';
import studos from '@/assets/about/companies/studos.svg';
import portrait from '@/assets/about/profile-blob.png';
import { Bio } from '@/components/about/Bio.component';
import { ExperienceList } from '@/components/about/ExperienceList.component';
import { ABOUT, COMPANY_COLORS, type CompanyId, type HintName } from '@/lib/copy/about';
import type { Locale } from '@/lib/i18n';

import type { ImageMetadata } from 'astro';

type Props = {
  /** Locale of the page. */
  locale: Locale;
};

const { locale } = Astro.props;
const copy = ABOUT[locale];

const logos: Record<CompanyId, ImageMetadata> = {
  caju,
  arco,
  studos,
  semantix,
  cosmobots,
  digisystem,
};

const experiences = copy.companies.map(company => ({
  ...company,
  color: COMPANY_COLORS[company.id],
  logo: {
    src: logos[company.id].src,
    width: logos[company.id].width,
    height: logos[company.id].height,
  },
}));

// Placeholders until the final pictures arrive; the plan tracks the swap
const hints: Record<HintName, { src: string; alt: string }> = {
  horizon: {
    src: 'https://placehold.co/320x200/332d3c/efeef1.png?text=Horizon',
    alt: copy.hints.horizon,
  },
  livestreams: {
    src: 'https://placehold.co/320x200/332d3c/efeef1.png?text=Live',
    alt: copy.hints.livestreams,
  },
  gym: { src: 'https://placehold.co/320x200/332d3c/efeef1.png?text=Gym', alt: copy.hints.gym },
};
---

<section aria-labelledby="whoami-title" class="site-whoami">
  <Container className="site-whoami__content">
    <div class="site-whoami__about">
      <div class="site-whoami__texts">
        <Tag appearance="brand" kind="filled">
          {copy.tag}
        </Tag>
        <Text element="h2" id="whoami-title" kind="heading-2">
          {copy.heading}
        </Text>
        <Bio client:visible hints={hints} paragraphs={copy.bio} />
      </div>
      <div class="site-whoami__experience">
        <Text element="h3" kind="heading-3">
          {copy.experience}
        </Text>
        <ExperienceList items={experiences} />
      </div>
    </div>
    <div class="site-whoami__sticky">
      <Image
        alt={copy.portraitAlt}
        class="site-whoami__portrait"
        densities={[1, 2]}
        height={571}
        src={portrait}
        width={556}
      />
    </div>
  </Container>
</section>

<style lang="scss">
  @use '@dgbragas/yalatus/styles/mixins' as *;

  .site-whoami {
    padding-block: var(--yl-space-96);

    :global(.site-whoami__content) {
      display: grid;
      gap: var(--yl-space-64);

      @include from('web') {
        // FIGMA: text column is 592px and the portrait 556px, with a 68px gap.
        gap: calc(var(--yl-space-64) + var(--yl-space-4));
        grid-template-columns: minmax(0, 592px) minmax(0, 556px);
        justify-content: space-between;
      }
    }

    &__about {
      display: flex;
      flex-direction: column;
      gap: var(--yl-space-120);
    }

    &__texts {
      align-items: flex-start;
      display: flex;
      flex-direction: column;
      gap: var(--yl-space-16);
    }

    :global(.site-bio) {
      display: flex;
      flex-direction: column;
      gap: var(--yl-space-16);
    }

    :global(.site-bio__closing) {
      font-style: italic;
    }

    &__experience {
      display: flex;
      flex-direction: column;
      gap: var(--yl-space-40);
    }

    :global(.site-experience) {
      display: flex;
      flex-direction: column;
      gap: var(--yl-space-32);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    &__sticky {
      align-self: start;
      padding-block-start: var(--yl-space-112);
      position: sticky;
      top: var(--site-header-offset);

      @include until('web') {
        padding-block-start: 0;
        position: static;
      }
    }

    :global(.site-whoami__portrait) {
      block-size: auto;
      inline-size: 100%;
    }
  }
</style>
