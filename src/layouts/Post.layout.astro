---
import { SmoothScroll } from '@/helpers';
import { LayoutProvider, StylesProvider } from '@/providers';

const { modifiedTime, publishedTime, section, tags, ...layoutProps } =
  Astro.props;

const jsonLD = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: layoutProps.title,
  description: layoutProps.description,
  image: layoutProps.image,
  author: {
    '@type': 'Person',
    name: "Diego '@dgbragas' Braga",
  },
  publisher: {
    '@type': 'Organization',
    name: 'Dgbragas',
    logo: {
      '@type': 'ImageObject',
      url: 'https://dgbragas.dev/logo.png',
    },
  },
  datePublished: publishedTime,
  dateModified: modifiedTime,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': layoutProps.url,
  },
};
---

<LayoutProvider {...layoutProps}>
  <Fragment slot='meta'>
    <meta property='article:author' content="Diego '@dgbragas' Braga" />
    <meta property='article:section' content={section} />
    {tags?.map((tag: string) => <meta property='article:tag' content={tag} />)}
    <meta property='article:published_time' content={publishedTime} />
    <meta property='article:modified_time' content={modifiedTime} />
  </Fragment>

  <StylesProvider>
    <slot />
  </StylesProvider>

  <Fragment slot='scripts'>
    <script type='application/ld+json' set:html={JSON.stringify(jsonLD)} />
  </Fragment>

  <SmoothScroll client:only />
</LayoutProvider>
