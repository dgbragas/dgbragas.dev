{
  "name": "dgbragas-dev",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "yarn workspace @dgbragas/site dev",
    "build": "yarn workspaces foreach -At run build",
    "preview": "yarn workspace @dgbragas/site preview",
    "storybook": "yarn workspace @dgbragas/yalatus storybook",
    "test": "yarn workspaces foreach -At run test",
    "test:coverage": "yarn workspaces foreach -At run test:coverage",
    "test:e2e": "yarn workspace @dgbragas/site test:e2e",
    "lint": "eslint . && stylelint \"**/*.scss\" && prettier --check .",
    "lint:fix": "eslint . --fix && stylelint \"**/*.scss\" --fix && prettier --write .",
    "typecheck": "yarn workspaces foreach -At run typecheck",
    "new:component": "yarn workspace @dgbragas/yalatus new:component",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,astro,mjs,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
