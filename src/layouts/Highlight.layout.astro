---
import { Container, Link, type LinkProps, Tag, Text } from '@/components/lib';
import { BaseLayout } from '@/layouts';

import './Highlight.styles.scss';

const {
  callToAction,
  image,
  links,
  tag,
  title,
  sectionTheme,
  className = '',
} = Astro.props;

const theme: 'dark' | 'light' = sectionTheme.split('-')[2];
---

<BaseLayout>
  <section
    class={`styled-section ${sectionTheme} section-highlight ${className}`}
  >
    <Container>
      <div class={`section-highlight__intro ${theme}`}>
        <div class='section-highlight__intro__presentation'>
          <Tag label={tag} />
          <Text element='h1' variant='heading-1'>{title}</Text>
          <Text element='p' variant='intro'>
            <slot name='description' />
          </Text>
        </div>

        <a href='#content'>
          {callToAction}

          <svg
            width='24'
            height='24'
            viewBox='0 0 24 24'
            fill='none'
            xmlns='http://www.w3.org/2000/svg'
          >
            <path
              d='M6.67603 6.61702C6.67603 5.12729 7.26782 3.69858 8.32121 2.64519C9.37461 1.59179 10.8033 1 12.293 1C13.7828 1 15.2115 1.59179 16.2649 2.64519C17.3183 3.69858 17.9101 5.12729 17.9101 6.61702V12.234C17.9101 13.7238 17.3183 15.1525 16.2649 16.2059C15.2115 17.2593 13.7828 17.8511 12.293 17.8511C10.8033 17.8511 9.37461 17.2593 8.32121 16.2059C7.26782 15.1525 6.67603 13.7238 6.67603 12.234V6.61702Z'
              stroke='#F0F0F0'
              stroke-width='1.40426'
              stroke-linejoin='round'></path>
            <path
              d='M12.293 4.74414V8.48882'
              stroke='#F0F0F0'
              stroke-width='1.40426'
              stroke-linecap='round'
              stroke-linejoin='round'></path>
            <path
              d='M8.54834 20.6602L12.293 23.0006L16.0377 20.6602'
              stroke='#F0F0F0'
              stroke-width='1.40426'
              stroke-linecap='round'
              stroke-linejoin='round'></path>
          </svg>
        </a>

        {image && <img alt='' aria-hidden src={image} />}
      </div>
    </Container>

    <div aria-hidden class='section-highlight__circle'></div>

    <div aria-hidden class='section-highlight__curve'>
      <svg
        viewBox='0 0 1440 76'
        xmlns='http://www.w3.org/2000/svg'
        preserveAspectRatio='none'
      >
        <path
          d='M0 0.648438C582 86.7027 897.146 86.1965 1440 0.648438V75.8415H0V0.648438Z'
          fill='white'></path>
      </svg>
    </div>
  </section>

  <section
    class='styled-section section--light section-highlight__content'
    id='content'
  >
    <Container>
      <div class='section-highlight__content__navigation'>
        <Text className='sr-only' element='h3'>
          Filtre o conteúdo apresentado
        </Text>

        <div>
          {
            links?.map((link: LinkProps & { active: boolean }) => (
              <Link
                aria-current={link.active}
                aria-label={link['aria-label']}
                className={link.active ? '--active' : ''}
                href={link.href}
                target='_self'
              >
                {link.children}
              </Link>
            ))
          }
        </div>
      </div>

      <div class='section-highlight__content__posts'>
        <slot />
      </div>
    </Container>
  </section>
</BaseLayout>
