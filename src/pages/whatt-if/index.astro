---
import { getRepos } from '@/api';
import { CardGitHub } from '@/components/local';
import { HighlightLayout } from '@/layouts';

import './_whatt-if.styles.scss';

const fullUrl = new URL(import.meta.env.SITE + Astro.request.url);
const currentFilter = fullUrl.searchParams.get('filter') ?? 'all';

const repositories = await getRepos();

const links = [
  {
    'aria-label': 'Filtrar por Todos',
    active: currentFilter.includes('all'),
    href: '?filter=all',
    children: 'Todos',
  },
  {
    'aria-label': 'Filtrar por Actions',
    active: currentFilter.includes('actions'),
    href: '?filter=actions',
    children: 'Actions',
  },
  {
    'aria-label': 'Filtrar por Linters',
    active: currentFilter.includes('linters'),
    href: '?filter=linters',
    children: 'Linters',
  },
  {
    'aria-label': 'Filtrar por Design System',
    active: currentFilter.includes('ds'),
    href: '?filter=design-system',
    children: 'Styles',
  },
  {
    'aria-label': 'Filtrar por Utils',
    active: currentFilter.includes('utils'),
    href: '?filter=utils',
    children: 'Utils',
  },
];

const repositoriesList = () => {
  if (currentFilter !== 'all') {
    return repositories.filter(({ name }) => currentFilter.includes(name));
  }

  return repositories;
};

const props = {
  pageProps: {
    links,
    callToAction: 'Saiba mais sobre o projeto',
    className: 'whatt-if--highlight',
    tag: '⚠️ Em desenvolvimento',
    title: '“Muitas coisas criadas com design, código, testes e um bom café.”',
    sectionTheme: 'section--dark',
  },
  layoutProps: {
    title: 'whatt-if | dgbragas - UI Engineer',
    description:
      'O whatt-if é um projeto pessoal open-source voltado a centralizar uma série de utilitários de desenvolvimento',
    url: 'https://dgbragas.dev/whatt-if',
  },
};
---

<HighlightLayout {...props}>
  <Fragment slot='description'>
    O <i>whatt-if</i> é um projeto pessoal open-source voltado a centralizar uma
    série de <strong>utilitários de desenvolvimento</strong>, trazendo:
    <i>help functions</i>, <i>linters</i>, <i>boilerplates</i> e os componentes que
    utilizo como meu <strong><u>Design System pessoal</u></strong>.
  </Fragment>

  <div class='whatt-if__posts'>
    {
      repositoriesList().map((repo, index) => (
        <CardGitHub
          data-aos='fade-up'
          data-aos-delay={100 * index}
          description={repo.description ?? '--'}
          repoUrl={repo.html_url}
          variant='extended'
          title={`whatt-if - ${repo.name}`}
        />
      ))
    }
  </div>
</HighlightLayout>
