---
import Illustration404 from '@/assets/illustrations/404.svg?url';
import { Container, Link, Text } from '@/components/lib';
import { BaseLayout } from '@/layouts';

import './_404.styles.scss';

const layoutProps = {
  title: '404 | dgbragas - UI Engineer',
  description: "Oh Shit! You are in a wrong place. Let's go back?",
  url: 'https://dgbragas.dev/404',
};
---

<BaseLayout {...layoutProps}>
  <section class='styled-section section--dark'>
    <div class='section-404'>
      <Container>
        <div class='section-404__content'>
          <div class='section-404__content__cta' data-aos='fade-up'>
            <img alt='404 - Oh shit' src={Illustration404} />
            <Text element='h1' variant='heading-3'>
              You're in a wrong place
            </Text>
            <a class='button' href='/'>Go back home</a>
          </div>

          <div class='section-404__content__copy'>
            <Text element='small' variant='small'>
              Reference by Kieran James on
              <Link href='https://dribbble.com/shots/6551175-404-Daily-UI-008'>
                Dribbble
              </Link>
            </Text>
          </div>
        </div>
      </Container>
    </div>
  </section>
</BaseLayout>
