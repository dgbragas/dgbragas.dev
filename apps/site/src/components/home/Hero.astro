---
import { Image } from 'astro:assets';

import { Button, Container, Text } from '@dgbragas/yalatus';

import Arco from '@/assets/home/logos/arco.svg';
import Caju from '@/assets/home/logos/caju.svg';
import Cosmobots from '@/assets/home/logos/cosmobots.svg';
import Digisystem from '@/assets/home/logos/digisystem.svg';
import Semantix from '@/assets/home/logos/semantix.svg';
import Studos from '@/assets/home/logos/studos.svg';
import { LocalTime } from '@/components/LocalTime/LocalTime.component';
import { COMPANY_NAMES, GRID_IMAGES, HOME } from '@/lib/copy/home';
import { localizePath, type Locale } from '@/lib/i18n';

import type { ImageMetadata } from 'astro';

type Props = {
  /** Locale of the page. */
  locale: Locale;
};

const { locale } = Astro.props;
const copy = HOME[locale];

const logos = [
  { Logo: Digisystem, name: COMPANY_NAMES.digisystem },
  { Logo: Studos, name: COMPANY_NAMES.studos },
  { Logo: Caju, name: COMPANY_NAMES.caju },
  { Logo: Arco, name: COMPANY_NAMES.arco },
  { Logo: Cosmobots, name: COMPANY_NAMES.cosmobots },
  { Logo: Semantix, name: COMPANY_NAMES.semantix },
];

const files = import.meta.glob<ImageMetadata>('@/assets/home/grid/*.png', {
  eager: true,
  import: 'default',
});
const grid = GRID_IMAGES.map(name => {
  const image = files[`/src/assets/home/grid/${name}.png`];
  if (!image) throw new Error(`Missing hero grid image: ${name}.png`);
  return { name, image, alt: copy.gridAlt[name] };
});
---

<section class="site-hero site-section">
  <Container className="site-hero__intro">
    <div class="site-hero__heading">
      <div class="site-hero__texts">
        <LocalTime client:idle locale={locale} />
        <Text className="site-hero__title" align="center" element="h1" kind="display">
          {copy.title.map((line, index) => (
            <>
              {index > 0 && <br />}
              {line.map(part =>
                part.accent ? (
                  <span class:list={['site-hero__accent', `site-hero__accent--${part.accent}`]}>
                    {part.text}
                  </span>
                ) : (
                  part.text
                )
              )}
            </>
          ))}
        </Text>
        <Text
          className="site-hero__description"
          align="center"
          color="fg-subtle"
          element="p"
          kind="body-lg"
        >
          {copy.description.map(part => (part.strong ? <strong>{part.text}</strong> : part.text))}
        </Text>
      </div>
      <div class="site-hero__actions">
        <Button as="a" href={localizePath(locale, '/portfolio')} trailingIcon="arrow-right">
          {copy.cases}
        </Button>
        <Button appearance="neutral" as="a" href={localizePath(locale, '/sobre')} kind="ghost">
          {copy.about}
        </Button>
      </div>
    </div>
    <div class="site-hero__trusted">
      <Text align="center" color="fg-subtle" element="p">
        {copy.trusted}
      </Text>
      <ul class="site-hero__logos">
        {logos.map(({ Logo, name }) => (
          <li class="site-hero__logo">
            <Logo aria-label={name} role="img" />
          </li>
        ))}
      </ul>
    </div>
  </Container>
  <Container className="site-hero__canvas">
    <ul aria-label={copy.gridLabel} class="site-hero__grid">
      {grid.map(({ alt, image, name }, index) => (
        <li class="site-hero__cell">
          <Image
            alt={alt}
            densities={[1, 2]}
            fit="cover"
            height={171}
            loading={index < 4 ? 'eager' : 'lazy'}
            src={image}
            width={293}
            data-name={name}
          />
        </li>
      ))}
    </ul>
  </Container>
</section>

<style lang="scss">
  @use '@dgbragas/yalatus/styles/mixins' as *;

  .site-hero {
    display: flex;
    flex-direction: column;
    gap: var(--yl-space-64);
    padding-block: var(--yl-space-192) var(--yl-space-96);

    @include until('tablet') {
      padding-block-start: var(--yl-space-120);
    }

    :global(.site-hero__intro) {
      display: flex;
      flex-direction: column;
      gap: var(--yl-space-120);
    }

    &__heading {
      align-items: center;
      display: flex;
      flex-direction: column;
      gap: var(--yl-space-40);
    }

    &__texts {
      align-items: center;
      display: flex;
      flex-direction: column;
      gap: var(--yl-space-4);
    }

    // FIGMA: heading column is 1008px and the description 800px, both outside the spacing scale.
    :global(.site-hero__title) {
      margin-block-end: var(--yl-space-4);
      max-inline-size: 1008px;
      overflow-wrap: anywhere;

      @include until('tablet') {
        font: var(--yl-text-title);
        letter-spacing: var(--yl-text-title-tracking);
      }
    }

    :global(.site-hero__description) {
      max-inline-size: 800px;
    }

    &__accent {
      &--trace {
        color: var(--yl-color-trace-300);
      }

      &--signal {
        color: var(--yl-color-signal-300);
      }
    }

    &__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--yl-space-16);
      justify-content: center;
    }

    &__trusted {
      display: flex;
      flex-direction: column;
      gap: var(--yl-space-24);
    }

    &__logos {
      align-items: center;
      color: var(--yl-color-fg-subtle);
      display: flex;
      flex-wrap: wrap;
      gap: var(--yl-space-16);
      justify-content: center;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    &__logo {
      align-items: center;
      display: flex;
      justify-content: center;

      :global(svg) {
        block-size: var(--yl-space-32);
        inline-size: auto;
      }
    }

    :global(.site-hero__canvas) {
      display: flex;
      justify-content: center;
    }

    &__grid {
      background-color: var(--yl-color-surface-strong);
      border: var(--yl-border-width-1) solid var(--yl-color-border-subtle);
      border-radius: var(--yl-radius-2);
      display: grid;
      gap: var(--yl-space-8);
      grid-template-columns: repeat(4, minmax(0, 1fr));
      inline-size: 100%;
      list-style: none;
      margin: 0;
      padding: var(--yl-space-12);

      @include until('tablet') {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    &__cell {
      aspect-ratio: 293 / 171;
      overflow: hidden;

      :global(img) {
        block-size: 100%;
        display: block;
        inline-size: 100%;
        object-fit: cover;
      }
    }
  }
</style>
