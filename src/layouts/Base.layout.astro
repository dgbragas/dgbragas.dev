---
import { AnnouncementBar, Link } from '@/components/lib';
import { Footer, TopMenu } from '@/components/local';
import { AOSProvider, SmoothScroll } from '@/helpers';
import { LayoutProvider, StylesProvider } from '@/providers';

import './Base.styles.scss';

const props = Astro.props;
---

<LayoutProvider {...props}>
  <StylesProvider>
    <div class='fixed-header'>
      <AnnouncementBar client:visible unfixed>
        Portfólio em versão <i>beta</i> — fique à vontade para visualizar o
        <Link
          href='https://github.com/dgbragas/dgbragas.dev?tab=readme-ov-file#%EF%B8%8F-roadmap'
        >
          roadmap do projeto
        </Link>
        ♥️
      </AnnouncementBar>
      <TopMenu client:only unfixed />
    </div>

    <main>
      <slot />
    </main>

    <Footer />

    <slot name='scripts' />
    <SmoothScroll client:only />
    <AOSProvider client:only />
  </StylesProvider>
</LayoutProvider>
