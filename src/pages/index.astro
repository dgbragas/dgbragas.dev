---
import ArrowDownIcon from '@/assets/icons/arrow-down.svg?raw';

/* Socials Icons */
import BehanceIcon from '@/assets/icons/linkedin.svg?raw';
import DribbbleIcon from '@/assets/icons/dribbble.svg?raw';
import GitHubIcon from '@/assets/icons/github.svg?raw';
import InstagramIcon from '@/assets/icons/instagram.svg?raw';
import LinkedInIcon from '@/assets/icons/linkedin.svg?raw';
import TwitterIcon from '@/assets/icons/twitter.svg?raw';
import WhatsAppIcon from '@/assets/icons/whatsapp.svg?raw';

/* About Icons */
import CSSIcon from '@/assets/icons/css.svg?raw';
import HTMLIcon from '@/assets/icons/html.svg?raw';
import JSIcon from '@/assets/icons/js.svg?raw';

/* Work Illustrations */
import AppIllustration from '@/assets/illustrations/apps.svg?raw';
import DesignIllustration from '@/assets/illustrations/design.svg?raw';
import StrongIllustration from '@/assets/illustrations/strong.svg?raw';
import WebIllustration from '@/assets/illustrations/web-development.svg?raw';

/* Workflow Illustrations */
import DeliveryIllustration from '@/assets/illustrations/delivery.svg?raw';
import FrontEndIllustration from '@/assets/illustrations/front-end.svg?raw';
import LayoutIllustration from '@/assets/illustrations/layout.svg?raw';
import MeetingIllustration from '@/assets/illustrations/meeting.svg?raw';
import PhoneIllustration from '@/assets/illustrations/phone.svg?raw';
import RefineIllustration from '@/assets/illustrations/refine.svg?raw';
import SearchIllustration from '@/assets/illustrations/search.svg?raw';
import WireframeIllustration from '@/assets/illustrations/wireframe.svg?raw';

import { getPortfolioPosts, getPosts } from '@/api';
import {
  Button,
  CardPortfolio,
  CardPost,
  Container,
  FeaturedIcon,
  Link,
  Tag,
  Text,
} from '@/components/lib';
import {
  CardHow,
  CardWorkflow,
  TestimonySlider,
  CardUI,
} from '@/components/local';
import { socials } from '@/constants';
import { BaseLayout } from '@/layouts';
import { getCurrentYear, limitWords, plainText, slugify } from '@/utils';

import './_index.styles.scss';

const careerTime = getCurrentYear() - 2018;
const socialsList = [
  {
    ariaLabel: 'Acessar o LinkedIn',
    href: socials.linkedIn,
    icon: LinkedInIcon,
  },
  { ariaLabel: 'Acessar o GitHub', href: socials.github, icon: GitHubIcon },
  {
    ariaLabel: 'Acessar o Instagram',
    href: socials.instagram,
    icon: InstagramIcon,
  },
  {
    ariaLabel: 'Enviar uma mensagem no WhatsApp',
    href: socials.whatsApp,
    icon: WhatsAppIcon,
  },
  {
    ariaLabel: 'Acessar o X (Twitter)',
    href: socials.twitter,
    icon: TwitterIcon,
  },
  {
    ariaLabel: 'Acessar o Dribbble',
    href: socials.dribbble,
    icon: DribbbleIcon,
  },
  { ariaLabel: 'Acessar o Behance', href: socials.behance, icon: BehanceIcon },
];

const workflows = [
  {
    count: 1,
    description:
      'Através de conversas presenciais ou à distância elaboro junto com o cliente um mapeamento das principais metas para o cumprimento do projeto.',
    icon: MeetingIllustration,
    title: 'Reunião',
    variant: 'default',
  },
  {
    count: 2,
    description:
      'Baseado em referências apresentadas pelo próprio cliente e outras pesquisas elaboradas em primeira pessoa, levanto um moodboard para dar início ao processo criativo.',
    icon: SearchIllustration,
    title: 'Pesquisas',
    variant: 'default',
  },
  {
    count: 3,
    description:
      'Finalizada a etapa de pesquisa é o momento de desenvolver um protótipo de baixa fidelidade (wireframe) de como será o layout da aplicação web, mobile ou dashboard.',
    icon: WireframeIllustration,
    title: 'Wireframe',
    variant: 'default',
  },
  {
    count: 4,
    description:
      'Aprovado o wireframe inicio o processo para escolher uma boa composição de cores, a melhor tipografia ao projeto e uma excelente hierarquia visual aos elementos construídos.',
    icon: LayoutIllustration,
    title: 'Layout',
    variant: 'default',
  },
  {
    count: 5,
    description:
      'Validado com o cliente se o resultado está aderente às expectativas estabelecidas na primeira etapa do processo é o momento (se necessário) de fazer ajustes antes da entrega.',
    icon: RefineIllustration,
    title: 'Refinamentos',
    variant: 'default',
  },
  {
    count: 6,
    description:
      'Sendo desejo do cliente a codificação da interface construída, iniciamos um processo de escolha de tecnologias para dar vida ao protótipo criado.',
    icon: FrontEndIllustration,
    title: 'Front-end',
    variant: 'default',
  },
  {
    count: 7,
    description:
      'Resultado em suas mãos, o seu projeto está funcional, entregue, performático e pronto para utilização. Foi um grande prazer trabalhar ao seu lado! :D',
    icon: DeliveryIllustration,
    title: 'Entrega',
    variant: 'featured',
  },
];

const testimonials = [
  {
    author: 'Carlos',
    content:
      '“Humildemente falando considero o Diego o melhor UI Designer que eu conheço. Obrigado por tudo, grato demais por esse trabalho tu é foda”',
    description: 'Depoimento pós site institucional',
  },
  {
    author: 'Danilo',
    content:
      '“Gostei muito do novo portfólio, de verdade. Achei incrível o trabalho, gostei muito. Recomendo muito, ficou monstro!”',
    description: 'Avaliação pós-entrega',
  },
];

const { posts } = await getPosts(2);
const { publicPosts } = await getPortfolioPosts(4);
---

<BaseLayout>
  <section class='styled-section section--light s-presentation'>
    <Container>
      <div class='s-presentation__content'>
        <div class='s-presentation__content__intro'>
          <div class='s-presentation__content__intro__labels'>
            <Tag label='Olá, eu sou o dg_' variant='filled' />
            <Link
              aria-label='Enviar e-mail para work@dgbragas.com'
              href={socials.mail}
            >
              work@dgbragas.com
            </Link>
          </div>

          <div class='s-presentation__content__intro__heading'>
            <Text element='h1' variant='heading-1'>
              User Interface Designer & Front-end Developer
              <Text element='span' variant='heading-1'>
                |

                <!-- <svg
                  width='157'
                  height='45'
                  viewBox='0 0 157 45'
                  fill='none'
                  xmlns='http://www.w3.org/2000/svg'
                >
                  <g clip-path='url(#clip0_2002_1019)'>
                    <path
                      d='M151.773 9.32994C150.952 8.83819 149.603 8.62752 147.709 8.70073C138.869 8.97426 129.778 10.3045 121.153 11.1586C116.23 11.6749 111.988 12.2956 106.998 12.6178C103.896 12.8677 100.194 13.2054 96.5524 13.7383C93.5242 14.1814 90.3485 14.238 87.3204 14.6812C86.7134 14.77 85.4324 14.7534 84.8992 15.0354C80.7983 16.0435 77.0156 16.189 73.3133 16.5268C69.6044 16.8655 66.5698 17.3095 63.4746 17.56C59.7966 17.881 55.5481 18.5026 51.237 18.9159C47.0506 19.3165 42.7929 19.6359 38.5702 20.2988C34.2758 20.9738 30.0817 21.5563 25.7202 21.9427C20.6018 22.3933 15.6247 23.1867 10.7147 23.556C8.1646 23.7516 5.74428 23.97 3.38834 24.1251'
                      stroke='#2060DF'
                      stroke-width='5'
                      stroke-linecap='round'
                      stroke-linejoin='round'></path>
                    <path
                      d='M83.1578 29.8509C83.4261 29.4439 83.9834 29.0808 84.8391 28.7593C88.8182 27.2246 93.1164 26.1824 97.1141 24.9851C99.4015 24.3165 101.407 23.8302 103.686 23.0496C105.113 22.5897 106.823 22.0611 108.545 21.6436C109.977 21.2964 111.398 20.7238 112.83 20.3767C113.117 20.3071 113.682 20.056 113.974 20.0991C115.993 19.8375 117.702 19.1953 119.412 18.6666C121.126 18.1372 122.56 17.7892 123.984 17.331C125.68 16.7983 127.689 16.3112 129.685 15.7058C131.622 15.1175 133.576 14.4743 135.581 14.0132C137.62 13.5447 139.597 13.0479 141.61 12.4192C143.971 11.6799 146.337 11.1426 148.59 10.4013C149.761 10.0182 150.879 9.67134 151.955 9.30435'
                      stroke='#2060DF'
                      stroke-width='5'
                      stroke-linecap='round'
                      stroke-linejoin='round'></path>
                  </g>
                  <defs>
                    <clipPath id='clip0_2002_1019'>
                      <rect
                        width='155'
                        height='23'
                        fill='white'
                        transform='translate(0 21.5718) rotate(-8)'></rect>
                    </clipPath>
                  </defs>
                </svg> -->
              </Text>
            </Text>
          </div>

          <Text element='p' variant='extended-large'>
            Solucionando os seus problemas através de uma stack baseada em
            <strong>tecnologia</strong> e <strong>design</strong>.
          </Text>

          <a
            aria-label='Enviar e-mail para work@dgbragas.com'
            class='button'
            href={socials.mail}
          >
            Comece um projeto
          </a>
        </div>

        <div class='s-presentation__content__footer'>
          <Text element='p'>Acompanhe o meu trabalho</Text>

          <div class='s-presentation__content__footer__socials'>
            <div>
              <Link href={socials.instagram} variant='instagram'>Instagram</Link
              >
              <Link href={socials.linkedIn} variant='linkedin'>LinkedIn</Link>
            </div>

            <Link href='#about' target='_self'>
              <span set:html={ArrowDownIcon} />
              Continue explorando
            </Link>
          </div>
        </div>
      </div>
    </Container>

    <div class='s-presentation__blob-mask'>
      <div class='s-presentation__blob-mask__animation'></div>
      <Text className='s-presentation__blob-mask__text'>dgbragas</Text>
    </div>
  </section>

  <section class='styled-section section--dark s-about' id='#about'>
    <Container>
      <div class='s-about__content'>
        <div class='s-about__content__intro'>
          <div class='section-intro --dark'>
            <Text element='small' variant='caption'>UI Engineer</Text>
            <Text element='h2' variant='heading-2'>
              Quem sou
              <Text element='span' variant='heading-2'>.</Text>
            </Text>
          </div>

          <div class='s-about__content__intro__texts'>
            <Text element='p' variant='extended-medium'>
              Graduado em <strong>Análise e Desenvolvimento de Sistemas</strong>
              pela Faculdade Bandeirantes de Tecnologia (atual SPTech), atuo como
              <strong>Desenvolvedor Front-end</strong> e
              <strong>UI Designer</strong> há {careerTime} anos, dos quais tive a
              oportunidade de trabalhar nas empresas com foco em
              <strong>Consultoria</strong>,
              <strong>Desenvolvimento SaaS</strong>,
              <strong>Serviços Chatbot</strong>, <strong>Big Data</strong>
              e <strong>Educação</strong> aplicando meu conhecimento de
              <strong>Figma</strong>, <strong>React & Astro/Next.js</strong> (TypeScript
              + JavaScript), além de outras tecnologias que complementam meu stack.

              <a aria-label='Leia mais' href='/about'>...</a>
            </Text>

            <div class='s-about__content__intro__socials'>
              <div>
                {
                  socialsList.map(social => (
                    <FeaturedIcon
                      ariaLabel={social.ariaLabel}
                      href={social.href}
                      icon={social.icon}
                      openInNewTab
                      variant='on-dark'
                    />
                  ))
                }
              </div>

              <Link href='/files/cv-dgbragas.pdf'>Visualizar currículo</Link>
            </div>
          </div>
        </div>
        <div class='s-about__content__image'>
          <img alt='' aria-describedby='' src='/src/assets/images/me.png' />
          <div class='s-about__content__image__backdrop'>
            <div>
              <span set:html={HTMLIcon} />
              <span set:html={CSSIcon} />
              <span set:html={JSIcon} />
            </div>
            <Text element='span'>{'< dgbragas />'}</Text>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class='styled-section section--dark s-work'>
    <Container>
      <div class='section-intro --dark'>
        <Text element='small' variant='caption'> Como posso te ajudar </Text>
        <Text element='h2' variant='heading-2'>
          O que eu faço
          <Text element='span' variant='heading-2'> . </Text>
        </Text>
      </div>

      <div class='s-work__banners'>
        <CardHow
          description='Codificação de sites e hotsites totalmente responsivos que se comunicam especialmente com o seu público alvo.'
          icon={WebIllustration}
          title='Desenvolvimento de Interfaces Web'
        />
        <CardHow
          description='Utilizo todo o meu conhecimento em prototipação de aplicações e websites para tornar a sua solução mais atrativa e interativa.'
          icon={DesignIllustration}
          title='Design de Interfaces Web e Mobile'
        />
        <CardHow
          description='Desenvolvimento de aplicativos, dashboards e aplicações web performáticas através da linguagem de programação JavaScript.'
          icon={AppIllustration}
          title='Desenvolvimento de Aplicativos e Aplicações'
        />
      </div>

      <Text element='p' variant='label'>
        O fruto das melhores construções vem do esforço conjunto
        <span set:html={StrongIllustration} />
      </Text>
    </Container>
  </section>

  <section class='styled-section section--light s-how'>
    <Container>
      <div class='s-how__grid'>
        <div class='section-intro --light'>
          <Text element='small' variant='caption'>Workflow</Text>
          <Text element='h2' variant='heading-2'>
            Como eu faço
            <Text element='span' variant='heading-2'>.</Text>
          </Text>

          <Text element='p' variant='extended-medium'>
            Acredito que a criatividade é um fruto obtido através do trabalho em
            equipe envolvendo todos ao redor. Veja como funciona meu fluxo de
            trabalho:
          </Text>
        </div>

        {
          workflows.map(workflow => (
            <CardWorkflow
              count={workflow.count}
              description={workflow.description}
              icon={workflow.icon}
              title={workflow.title}
              variant={workflow.variant as 'featured' | 'default'}
              style={{
                gridArea: `card-${workflow.count}`,
              }}
            />
          ))
        }
      </div>

      <div class='s-how__highlight'>
        <span set:html={PhoneIllustration} />
      </div>
    </Container>
  </section>

  <section class='styled-section section--dark s-portfolio'>
    <Container>
      <div class='s-portfolio__header'>
        <div class='section-intro --dark'>
          <Text element='small' variant='caption'>
            Um trabalho constante de
            <Text element='small' variant='label'>Aprimoração.</Text>
            <Text element='small' variant='label'>Criação.</Text>
          </Text>
          <Text element='h2' variant='heading-2'>
            Portfólio
            <Text element='span' variant='heading-2'>.</Text>
          </Text>
        </div>

        <a aria-label='Ver todos os trabalhos' href='/portfolio' target='_self'>
          <Text element='span' variant='intro'>
            <span>ver</span>
            todos trabalhos
          </Text>

          <svg
            width='14'
            height='14'
            viewBox='0 0 14 14'
            fill='none'
            xmlns='http://www.w3.org/2000/svg'
          >
            <path
              d='M5 2.5C5 3.88071 3.88071 5 2.5 5C1.11929 5 0 3.88071 0 2.5C0 1.11929 1.11929 0 2.5 0C3.88071 0 5 1.11929 5 2.5Z'
              fill='url(#paint0_linear_2012_1135)'></path>
            <path
              d='M14 2.5C14 3.88071 12.8807 5 11.5 5C10.1193 5 9 3.88071 9 2.5C9 1.11929 10.1193 0 11.5 0C12.8807 0 14 1.11929 14 2.5Z'
              fill='url(#paint1_linear_2012_1135)'></path>
            <path
              d='M14 11.5C14 12.8807 12.8807 14 11.5 14C10.1193 14 9 12.8807 9 11.5C9 10.1193 10.1193 9 11.5 9C12.8807 9 14 10.1193 14 11.5Z'
              fill='url(#paint2_linear_2012_1135)'></path>
            <defs>
              <linearGradient
                id='paint0_linear_2012_1135'
                x1='14.6723'
                y1='-2.06818'
                x2='-0.870628'
                y2='13.727'
                gradientUnits='userSpaceOnUse'
              >
                <stop stop-color='#2060DF'></stop>
                <stop offset='1' stop-color='#00F0F0'></stop>
              </linearGradient>
              <linearGradient
                id='paint1_linear_2012_1135'
                x1='14.6723'
                y1='-2.06818'
                x2='-0.870628'
                y2='13.727'
                gradientUnits='userSpaceOnUse'
              >
                <stop stop-color='#2060DF'></stop>
                <stop offset='1' stop-color='#00F0F0'></stop>
              </linearGradient>
              <linearGradient
                id='paint2_linear_2012_1135'
                x1='14.6723'
                y1='-2.06818'
                x2='-0.870628'
                y2='13.727'
                gradientUnits='userSpaceOnUse'
              >
                <stop stop-color='#2060DF'></stop>
                <stop offset='1' stop-color='#00F0F0'></stop>
              </linearGradient>
            </defs>
          </svg>
        </a>
      </div>

      <div class='s-portfolio__posts'>
        {
          publicPosts.map(post => (
            <CardPortfolio
              description={post.description}
              image={{
                alt: post.image.alternativeText,
                caption: post.image.caption,
                src: post.image.url,
              }}
              labels={post.tags}
              url={{
                href: post.url,
                target: '_blank',
              }}
              title={post.title}
              variant='extended'
            />
          ))
        }
      </div>
    </Container>
  </section>

  <section class='styled-section section--light s-testimonials'>
    <Container>
      <div class='section-intro --light'>
        <Text element='small' variant='caption'
          >Relatos daqueles que tiveram meus serviços</Text
        >
        <Text element='h2' variant='heading-2'>
          Depoimentos
          <Text element='small' variant='heading-2'>.</Text>
        </Text>
      </div>

      <div class='s-testimonials__slider'>
        <TestimonySlider client:load testimonies={testimonials} />
      </div>
    </Container>
  </section>

  <section class='styled-section section--dark s-blog'>
    <Container>
      <div class='s-blog__intro'>
        <Text element='small' variant='caption'>Blog</Text>
        <Text element='h2' variant='heading-2'
          >Acompanhe as minhas postagens</Text
        >

        <div class='s-blog__intro__socials'>
          <FeaturedIcon
            ariaLabel='Ver outras postagens no Dribbble'
            href={socials.dribbble}
            icon={DribbbleIcon}
            variant='on-dark'
          />
          <FeaturedIcon
            ariaLabel='Ver outras postagens no Behance'
            href={socials.behance}
            icon={BehanceIcon}
            variant='on-dark'
          />
        </div>
      </div>

      <div class='s-blog__posts'>
        {
          posts.map(post => (
            <CardPost
              description={plainText(
                limitWords(
                  post.introElementsCount > 1 ? post.content : post.intro,
                  20,
                ),
              )}
              image={{
                alt: post.banner.alternativeText,
                src: post.banner.url,
              }}
              labels={post.tags}
              publishedAt={post.updatedAt}
              readTime={post.readTime}
              title={post.title}
              url={{
                href: `/blog/${slugify(post.title)}`,
                target: '_self',
              }}
            />
          ))
        }
      </div>

      <div class='s-blog__see-more'>
        <a class='button' href='/blog'>Todas postagens</a>
      </div>
    </Container>
  </section>
</BaseLayout>
