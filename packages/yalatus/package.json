{
  "name": "@dgbragas/yalatus",
  "version": "0.1.0",
  "private": true,
  "description": "Yalatus — the design system behind dgbragas.dev",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*/index.ts",
    "./constants": "./src/constants/index.ts",
    "./helpers": "./src/helpers/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./test-utils": "./src/test-utils/index.ts",
    "./tokens": "./tokens/yalatus.tokens.json",
    "./tokens/names": "./src/tokens/tokens.names.ts",
    "./tokens.css": "./src/tokens/tokens.css",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "build": "yarn tokens:build && yarn icons:build && tsc --noEmit",
    "tokens:build": "node ./scripts/build-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "new:component": "plop --plopfile ./plopfile.mjs component",
    "icons:build": "node ./scripts/build-icons.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "radix-ui": "^1.6.7"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-designs": "^11.1.4",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^5.0.3",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.0",
    "playwright": "^1.63.0",
    "plop": "^4.0.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.1",
    "storybook": "^10.6.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
